#include <bits/stdc++.h>
using namespace std;

int main() {
    int m;
    cin >> m;
    while(m--){
        int n;
        cin >> n;
        vector<int>a(n);
        int ttl = 0;
        for(int i=0; i<n; i++){
            cin >> a[i];
            ttl += a[i];
        }
        int minpair = INT_MAX;
        for (int i=0; i+1<n; i++){
            minpair = min(minpair, a[i]+a[i+1]);
        }
        cout << ttl-minpair/2<<"\n";
    }
    return 0;
}
