#include <bits/stdc++.h>
using namespace std;

int main() {
	int T;
	cin >> T;
	
	while(T--){
	    int N;
	    cin >> N;
	    vector <int> A(N);
	    for(int i = 0; i< N; i++)
	    cin >> A[i];
	    
	    sort(A.begin(), A.end());
	    int option1 = A[N-1] - A[1];
	    int option2 = A[N-2] - A[0];
	    cout << min(option1 , option2)<<'\n';
	}
 return 0;
}
