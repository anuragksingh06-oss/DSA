#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, K;
        cin >> N >> K;

        priority_queue<long long, vector<long long>, greater<long long>> pq;

        for (int i = 0; i < N; i++) {
            long long x;
            cin >> x;
            pq.push(x);
        }

        while (K--) {
            long long a = pq.top();
            pq.pop();

            long long b = pq.top();
            pq.pop();

            pq.push(a + b);
            pq.push(0);
        }

        long long ans = 0;
        while (!pq.empty()) {
            ans = max(ans, pq.top());
            pq.pop();
        }

        cout << ans << '\n';
    }

    return 0;
}