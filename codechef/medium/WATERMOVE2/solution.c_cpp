#include <bits/stdc++.h>
using namespace std;

int main() {
	int x;
	cin >> x;
	
	while(x--){
	    int n,k;
	    cin>>n>>k;
	    vector<long long> arr(n);
	    for(int i=0; i<n; i++){
	        cin >> arr[i];
	    }
	    sort(arr.rbegin(), arr.rend());
	    long long res = arr[0];
	    for(int i = 1; i<= min(k,n-1); i++){
	        res += arr[i];
	    }
	    cout << res <<'\n';
	}
	return 0;
	

}
