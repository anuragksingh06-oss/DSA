#include <bits/stdc++.h>
using namespace std;

int main() {
	int m;
	cin >> m;
	
	while(m--){
	    int n;
	    string s;
	    
	    cin>> n >>s;
	    
	    int count = 0;
	    int ans = 0;
	    
	    for(int i=0; i<n; i++){
	        if(i > 0 && s[i] == s[i-1])
	            count ++;
	       else
	            count = 1;
	            
	       if (count== 3){
	           ans++;
	           count = 0;
	       }	  
	       }
	       cout << ans <<endl;
	}
    return 0;
}
