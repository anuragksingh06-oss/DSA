#include <bits/stdc++.h>
using namespace std;

int main() {
	int M;
	cin >> M;
	
	while(M--){
	    int N;
	    cin >> N;
	    
	    vector<int> a(N);
	    
	    for(int i=0; i<N; i++){
	        cin >> a[i];
	    }
	    int first[2] = {-2,-2};
	    first[0] = -1;
	    
	    int parity = 0;
	    int answer = 0;
	    
	    for(int i=0; i<N; i++){
	        if(a[i] % 2 != 0){
	            parity ^= 1;
	        }
	        if (first[parity] != -2){
	            answer = max(answer, i-first[parity]);
	        }else{
	            first [parity] = i;
	        }
	    }
	    cout << answer << endl;
	    
	}
    return 0;
}
