#include <bits/stdc++.h>
using namespace std;

int main() {
    int m ;
    cin >> m;
    
    while(m--){
        int n;
        long long o;
        cin >> n >>o;
        
        vector<int> a(n);
        
        for(int i=0 ; i<n; i++)
        cin>> a[i];
        
        sort(a.begin(), a.end());
        
        long long people=0;
        int ans = 0;
        
        for(int i=0; i<n; i++){
            people += a[i];
            long long handshakes = people * (people-1)/2;
            if(handshakes <= o)
            ans++;
        else
            break;
        }
        cout << ans<<'\n';
    } 
return 0;
}
